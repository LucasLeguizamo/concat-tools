# Postgres (Neon/Supabase/local). Usar la URL con pooling en serverless.
DATABASE_URL=postgres://user:pass@localhost:5432/concat_gateway

# Cliente OAuth tipo "aplicación web" del proyecto GCP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL pública del gateway, sin barra final. Redirect de Google: ${PUBLIC_URL}/google/callback
PUBLIC_URL=http://localhost:3000

# Keyring del vault: "v1:base64key,v2:base64key". Cada clave = 32 bytes en base64. La ULTIMA es la activa.
# Generar: node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
VAULT_KEYS=

# Secreto del cron de salud (header Authorization: Bearer <CRON_SECRET>). Min 16 chars.
CRON_SECRET=

# Secreto HS256 de los access tokens del gateway. Min 32 chars.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Opcional. Google Ads dio de baja el developer token (2026-09-09); si se define, se envia en el header
# `developer-token` (la API lo ignora). No hace falta para el gateway oficial.
# GOOGLE_ADS_DEVELOPER_TOKEN=
